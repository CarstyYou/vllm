# 全量 log 不进 git（数字在 json/csv，证据在 evidence_*.txt）；task_01 已 tracked 的历史不回收
task_*/results/**/*.log
task_*/results/*smoke*
# 根 .gitignore 全局挡 *.csv；正式 bench/对拍 csv 是白名单产物
!task_*/results/*.csv
task_*/results/**/samples_*.jsonl
task_*/results/**/*.stdout
task_*/results/**/*.nsys-rep
task_*/results/bench_*.json
!task_*/results/exp05_summary.csv
!task_*/results/evidence_*.txt
# lean-commit policy (xiy 2026-07-16): only md / csv / evidence / gsm8k json / tests tracked.
# lm-eval verbose per-subtask json (aggregate number lives in result.md/precision.md):
task_*/results/**/results_*.json
task_*/results/**/*.stdout
task_*/results/**/*.nsys-rep
task_*/results/**/samples_*.jsonl
